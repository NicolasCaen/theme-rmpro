        "spacing": {
            "spacingSizes": [
                {
                    "slug": "1",
                    "name": ".5rem|8",
                    "size": ".5rem"
                },
                {
                    "slug": "2",
                    "name": "1rem|16",
                    "size": "1rem"
                },
                {
                    "slug": "3",
                    "name": "1.5rem|24",
                    "size": "1.5rem"
                },
                {
                    "slug": "4",
                    "name": "2rem|32",
                    "size": "2rem"
                },
                {
                    "slug": "5",
                    "name": "2.5rem|40",
                    "size": "2.5rem"
                },
                {
                    "slug": "6",
                    "name": "3rem|48",
                    "size": "3rem"
                },
                {
                    "slug": "7",
                    "name": "4.5rem|72",
                    "size": "4.5rem"
                },
                {
                    "slug": "8",
                    "name": "7.5rem|120",
                    "size": "7.5rem"
                },
                {
                    "slug": "9",
                    "name": "10rem|160",
                    "size": "10rem"
                },
                {
                    "slug": "10",
                    "name": "12.5rem|200",
                    "size": "12.5rem"
                },
                {
                    "slug": "headerheight",
                    "name": "header height",
                    "size": "var(--header-height)"
                }
            ],
            "defaultSpacingSizes": false,
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        }
    },
    "styles": {
         "css": ".wp-site-blocks > * { margin-block-start: 0; margin-block-end: 0; }",
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--first)",
            "fontSize": "var(--wp--preset--font-size--m)",
            "lineHeight" :"1",
            "fontWeight" : "300"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)",
                    "fontSize": "var(--wp--preset--font-size--h-1)",
                    "lineHeight": "1.1",
                    "letterSpacing" : ".1rem"
                }
            },
            "h2":{
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)",
                    "fontSize": "var(--wp--preset--font-size--h-2)",
                     "lineHeight": "1.1"
                }
            },
            "h3":{
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)",
                    "fontSize": "var(--wp--preset--font-size--h-3)",
                    "lineHeight":"1.1"
                }
            },
            "h4":{
                "typography": {
                   "fontWeight" : "400",
                     "fontSize": "var(--wp--preset--font-size--h-4)",
                     "lineHeight": "1.1"
                }
            },
            "h5":{
                "typography": {
                   "fontWeight" : "400",
                     "fontSize": "var(--wp--preset--font-size--h-5)",
                     "lineHeight":"1.1"
                }
            }
        },
       "blocks": {
                "core/query-pagination": {
                    "elements": {
                        "link": {
                            "color": {
                                "text": "var(--wp--preset--color--contrast-2)"
                            }
                        }
                    }
                },
                "woocommerce/product-image": {
                    "spacing": {
                        "margin": {
                            "right": "0",
                            "left": "0"
                        }
                    }
                },
                "woocommerce/breadcrumbs": {
                    "elements": {
                        "link": {
                            "color": {
                                "text": "var(--wp--preset--color--base-3)"
                            }
                        }
                    }
                },
                "core/button": {
                    "variations": {
                        "outline": {
                            "color": {
                                "text": "var(--wp--preset--color--contrast-2)",
                                "background": "transparent"
                            },
                            "typography": {
                                "fontSize": "var(--wp--preset--font-size--xs)",
                                "textTransform" : "uppercase"
                            },
                            "spacing": {
                                "padding": {
                                    "left": "var(--wp--preset--spacing--2)",
                                    "right": "var(--wp--preset--spacing--2)",
                                    "top": "var(--wp--preset--spacing--2)",
                                    "bottom": "var(--wp--preset--spacing--2)"
                                }
                            }
                        }
                    },
                    "color": {
                        "text": "var(--wp--preset--color--contrast-2)",
                        "background": "var(--wp--preset--color--accent)"
                    },
                    "elements": {
                        "link": {
                            "color": {
                                "text": "var(--wp--preset--color--contrast-2)"
                            }
                        }
                    },
                    "typography": {
                        "fontSize": "var(--wp--preset--font-size--xs)",
                        "textTransform" : "uppercase"
                    },
                    "spacing": {
                        "padding": {
                            "left": "var(--wp--preset--spacing--2)",
                            "right": "var(--wp--preset--spacing--2)",
                            "top": "var(--wp--preset--spacing--2)",
                            "bottom": "var(--wp--preset--spacing--2)"
                        }
                    }
                }
            }
    }

}