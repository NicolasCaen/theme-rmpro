{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1240px"
        },

        "color": {
            "palette": [
                {
                    "slug": "base",
                    "name": "Base",
                    "color": "#F0F0F0"
                },
                {
                    "slug": "base-2",
                    "name": "Base 2",
                    "color": "#FEFFC1"
                },
                {
                    "slug": "base-3",
                    "name": "Base 3",
                    "color": "#FFFFFF"
                },
                {
                    "slug": "contrast",
                    "name": "Contrast",
                    "color": "#656565"
                },
                {
                    "slug": "contrast-2",
                    "name": "Contrast 2",
                    "color": "#292929"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#FFD700"
                },
                {
                    "slug": "accent-2",
                    "name": "Accent 2",
                    "color": "#818181"
                }
            ],
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [
				{
					"colors": ["#111111", "#ffffff"],
					"slug": "duotone-1",
					"name": "Black and white"
				},
                {
					"colors": [ "#ffffff","#111111"],
					"slug": "duotone-1b",
					"name": "white and Black"
				},
				{
					"colors": ["#111111", "#C2A990"],
					"slug": "duotone-2",
					"name": "Black and sandstone"
				},
				{
					"colors": ["#111111", "#D8613C"],
					"slug": "duotone-3",
					"name": "Black and rust"
				},
				{
					"colors": ["#111111", "#B1C5A4"],
					"slug": "duotone-4",
					"name": "Black and sage"
				},
				{
					"colors": ["#111111", "#B5BDBC"],
					"slug": "duotone-5",
					"name": "Black and pastel blue"
				}
			]
        },
