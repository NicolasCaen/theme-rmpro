{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Big Gap",
    "slug": "big-gap",
    "blockTypes": ["ng1/media-text"],
    "styles": {
        "color": {
            "background": "var:preset|color|primary",
            "text": "var:preset|color|white"
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var:preset|color|accent"
                }
            }
            
        },
        "blocks": {
            "core/columns": {
                "css": "gap:var(--wp--custom--spacing-cols-gap, 7.5rem)"
            }
        }

    }
}